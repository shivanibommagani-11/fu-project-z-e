    PROCEDURE bulk_get_notice_rec (contract_nbrlistjson   IN     CLOB,
                                   o_ref_cur                 OUT ref_cur)
    AS
    BEGIN
        OPEN o_ref_cur FOR
              SELECT DISTINCT
                     cp.party_said,
                     cp.party_contact_mechsm_role_cd,
                     a.contact_mechsm_id,
                     a.line1_addr,
                     a.line2_addr,
                     a.line3_addr,
                     a.city_name,
                     a.state_name,
                     a.zip_code,
                     LTRIM (RTRIM (p.ename))
                         AS "ename",
                     LISTAGG (contract_nbr, ',')
                         WITHIN GROUP (ORDER BY contract_nbr)
                         AS contractnbr,
                     COUNT (*)
                         AS COUNT,
                     cp.vendor_location,
                     p.vendor_nbr
                FROM intranet.contract_party      cp
                     INNER JOIN intranet.contract cn
                         ON cp.contract_said = cn.contract_said,
                     netsites.vw_party_summary    p,
                     netsites.party_contact_mechsm pcm,
                     netsites.vw_contact_address  a,
                     (SELECT b.contractid
                        FROM JSON_TABLE (contract_nbrlistjson,
                                         '$[*]'
                                         COLUMNS (contractid PATH '$')) b) aa
               WHERE     cp.contract_said =
                         pg_contract.get_cur_contract (
                             TO_NUMBER (aa.contractid))
                     AND cp.party_contact_mechsm_role_cd = 'NOTC'
                     AND cp.party_said = p.party_id
                     AND p.party_id = pcm.party_id
                     AND pcm.contact_mechsm_id = a.contact_mechsm_id
                     AND a.active_ind = netsites.pg_global.c_boolean_true
                     AND a.id = 202
            GROUP BY cp.party_said,
                     cp.party_contact_mechsm_role_cd,
                     a.contact_mechsm_id,
                     a.line1_addr,
                     a.line2_addr,
                     a.line3_addr,
                     a.city_name,
                     a.state_name,
                     a.zip_code,
                     LTRIM (RTRIM (p.ename)),
                     cp.vendor_location,
                     p.vendor_nbr;
    END bulk_get_notice_rec;

    PROCEDURE bulk_get_owner (contract_nbrlistjson   IN     CLOB,
                              o_ref_cur                 OUT ref_cur)
    AS
        v_contract_type_code   intranet.contract.contract_type_code%TYPE;
        v_role_code            intranet.party_contact_role.party_contact_mechsm_role_cd%TYPE;
        c_owner_id    CONSTANT NUMBER := 201;
        c_ownr        CONSTANT VARCHAR2 (4) := 'OWNR';
        c_tena        CONSTANT VARCHAR2 (4) := 'TENA';

        CURSOR cur IS
            WITH
                tmp
                AS
                    (SELECT b.*
                       FROM JSON_TABLE (contract_nbrlistjson,
                                        '$[*]'
                                        COLUMNS (contractid PATH '$')) b)
            SELECT *
              FROM tmp;
    BEGIN
        FOR rec IN cur
        LOOP
            SELECT contract_type_code
              INTO v_contract_type_code
              FROM intranet.contract
             WHERE contract_said =
                   pg_contract.get_cur_contract (TO_NUMBER (rec.contractid));

            IF v_contract_type_code = 'SUBT'
            THEN
                v_role_code := c_tena;
            ELSE
                v_role_code := c_ownr;
            END IF;

            OPEN o_ref_cur FOR
                  SELECT DISTINCT
                         cp.contract_said,
                         p.ename
                             AS organization,
                         ia.line1_addr,
                         ia.line2_addr,
                         ia.line3_addr,
                         ia.city_name,
                         ia.state_postal_code,
                         cmt.ename
                             AS party_addr_role_code,
                         cp.party_contact_mechsm_role_cd,
                         cp.payee_chk_memo_text,
                         ia.zip_code,
                         LISTAGG (contract_nbr, ',')
                             WITHIN GROUP (ORDER BY contract_nbr)
                             AS contractnbr,
                         COUNT (*)
                             AS COUNT,
                         cp.vendor_location
                    FROM intranet.contract_party         cp
                         INNER JOIN intranet.contract cn
                             ON cp.contract_said = cn.contract_said,
                         netsites.vw_party_summary       p,
                         netsites.contact_mechsm         cm,
                         netsites.contact_addr           ca,
                         intranet.addr                   ia,
                         netsites.party_contact_mechsm   pcm,
                         netsites.contact_mechsm_category cmt,
                         (SELECT b.contractid
                            FROM JSON_TABLE (contract_nbrlistjson,
                                             '$[*]'
                                             COLUMNS (contractid PATH '$')) b)
                         aa
                   WHERE     cp.party_said = p.party_id
                         AND p.party_id = pcm.party_id
                         AND pcm.contact_mechsm_id = cm.id
                         AND cm.id = ca.contact_mechsm_id
                         AND ca.addr_id = ia.addr_said
                         AND cm.contact_mechsm_category_id = c_owner_id
                         AND cm.contact_mechsm_category_id = cmt.id
                         AND cp.party_contact_mechsm_role_cd = v_role_code
                         AND cp.contract_said =
                             pg_contract.get_cur_contract (
                                 TO_NUMBER (aa.contractid))
                         AND ca.active_ind = netsites.pg_global.c_boolean_true
                GROUP BY cp.contract_said,
                         p.ename,
                         ia.line1_addr,
                         ia.line2_addr,
                         ia.line3_addr,
                         ia.city_name,
                         ia.state_postal_code,
                         cmt.ename,
                         cp.party_contact_mechsm_role_cd,
                         cp.payee_chk_memo_text,
                         ia.zip_code,
                         LTRIM (RTRIM (p.ename)),
                         cp.vendor_location,
                         p.vendor_nbr;
        END LOOP;
    EXCEPTION
        WHEN OTHERS
        THEN
            DBMS_OUTPUT.put_line ('Some Exception: ');
    END bulk_get_owner;

    PROCEDURE sp_bulk_dish_sublease_terminate (
        p_contract_nbr_list IN CLOB,
        p_termination_dt    IN DATE     DEFAULT TO_DATE('12-JUN-2026', 'DD-MON-YYYY'),
        p_termination_code  IN VARCHAR2 DEFAULT 'LANDLORD',
        p_contract_desc     IN VARCHAR2 DEFAULT 'Terminated by VZ for default Dish did not cure. SRS 7/24/26',
        p_user_id           IN VARCHAR2 DEFAULT 'sztuksa',
        o_processed_count   OUT NUMBER
    ) IS
        TYPE t_said_list IS TABLE OF intranet.contract.contract_said%TYPE;
        v_said_list t_said_list;
        v_count     PLS_INTEGER := 0;
    BEGIN
        -- 1. Set session information
        DBMS_APPLICATION_INFO.set_client_info (p_user_id);
        DBMS_APPLICATION_INFO.set_module ('Bulk Dish sublease termination', '');
        APP_UTL.PKG_SQL.SET_SHOW_SQL (FALSE);

        -- 2. Fetch targeted target contract_said IDs using XMLTABLE
        WITH contract_list AS (
            SELECT TO_NUMBER(TRIM(COLUMN_VALUE)) AS contract_nbr
            FROM XMLTABLE(('"' || REPLACE(p_contract_nbr_list, ',', '","') || '"'))
        ),
        max_amendments AS (
            -- Filter contract table FIRST using indexed join before grouping
            SELECT c.contract_nbr, MAX(c.ammendment_nbr) AS max_ammendment_nbr
            FROM intranet.contract c
            JOIN contract_list cl ON cl.contract_nbr = c.contract_nbr
            GROUP BY c.contract_nbr
        )
        SELECT c.contract_said
        BULK COLLECT INTO v_said_list
        FROM intranet.contract c
        JOIN max_amendments ma ON ma.contract_nbr = c.contract_nbr 
                              AND ma.max_ammendment_nbr = c.ammendment_nbr;

        IF v_said_list.COUNT = 0 THEN
            o_processed_count := 0;
            RETURN;
        END IF;

        -- 3. Perform Set-Based Bulk Updates 
        FORALL i IN 1..v_said_list.COUNT
            UPDATE intranet.contract
            SET termination_dt   = p_termination_dt,
                termination_code = p_termination_code,
                contract_desc    = p_contract_desc,
                fas13_doc_id     = 'NOREQ'
            WHERE contract_said = v_said_list(i);

        FORALL i IN 1..v_said_list.COUNT
            UPDATE intranet.contract_pmt_date
            SET prorate_termination_compl_ind = 0
            WHERE contract_said = v_said_list(i);

        -- 4. Call payment engine recalculation per contract
        FOR i IN 1..v_said_list.COUNT LOOP
            intranet.pkg_pmts.payments_for_termination_dt (
                i_contract_id => v_said_list(i)
            );
            v_count := v_count + 1;
        END LOOP;

        o_processed_count := v_count;
        COMMIT;

    EXCEPTION
        WHEN OTHERS THEN
            ROLLBACK;
            DBMS_OUTPUT.PUT_LINE ('ERROR in sp_bulk_dish_sublease_terminate: ' || SQLERRM);
            RAISE;
    END sp_bulk_dish_sublease_terminate;
    
    PROCEDURE sp_bulk_payment_hold(
        p_contract_nbr_list     IN CLOB,
        p_payee_chk_memo_text   IN VARCHAR2,
        p_hold_comment          IN VARCHAR2,
        p_hold_payment_reason   IN VARCHAR2,
        p_stream_hold           IN VARCHAR2,
        p_accrual_status        IN VARCHAR2,
        p_mdg_number            IN VARCHAR2,
        p_user_id               IN VARCHAR2,
        o_processed_count       OUT NUMBER
    ) IS
        v_start_pos      INTEGER := 1;
        v_comma_pos      INTEGER;
        v_contract_id    VARCHAR2(50);
        v_count          NUMBER := 0;
        v_clob_len       INTEGER;
    BEGIN
        o_processed_count := 0;

        -- Safety check
        IF p_contract_nbr_list IS NULL THEN
            RETURN;
        END IF;

        v_clob_len := DBMS_LOB.GETLENGTH(p_contract_nbr_list);

        -- Loop through the comma-separated CLOB
        WHILE v_start_pos <= v_clob_len LOOP
            v_comma_pos := DBMS_LOB.INSTR(p_contract_nbr_list, ',', v_start_pos);

            IF v_comma_pos = 0 THEN
                -- Last item in the list
                v_contract_id := TRIM(DBMS_LOB.SUBSTR(p_contract_nbr_list, v_clob_len - v_start_pos + 1, v_start_pos));
                v_start_pos := v_clob_len + 1;
            ELSE
                -- Extract the contract ID up to the comma
                v_contract_id := TRIM(DBMS_LOB.SUBSTR(p_contract_nbr_list, v_comma_pos - v_start_pos, v_start_pos));
                v_start_pos := v_comma_pos + 1;
            END IF;

            IF v_contract_id IS NOT NULL THEN
                -- ==========================================================
                -- 1. Apply the hold using the package from your sample SQL
                -- ==========================================================
                intranet.pkg_pmts.hnp_log (
                    i_created_by  => p_user_id,
                    i_contract_id => TO_NUMBER(v_contract_id),
                    i_pmt_method  => p_stream_hold, 
                    i_msg_code    => intranet.pkg_global.c_pmt_hold_msg_code_info,
                    i_msg         => p_hold_comment,
                    i_object_name => 'PG_FUZE_BULK_UPD.sp_bulk_payment_hold'
                );

                -- ==========================================================
                -- 2. Update Main Contract Data (Placeholder)
                -- ==========================================================
                -- Your Java code passes parameters like Accrual Status and MDG Number.
                -- You will likely need an UPDATE statement here to apply those to the main table.
                /*
                UPDATE INTRANET.YOUR_MAIN_CONTRACT_TABLE
                   SET PAYEE_CHK_MEMO_TEXT = p_payee_chk_memo_text,
                       HOLD_PAYMENT_REASON = p_hold_payment_reason,
                       ACCRUAL_STATUS      = p_accrual_status,
                       MDG_NUMBER          = p_mdg_number,
                       MODIFIED_BY         = p_user_id,
                       MODIFIED_DATE       = SYSDATE
                 WHERE CONTRACT_NUMBER     = v_contract_id;
                */

                v_count := v_count + 1;
            END IF;
        END LOOP;

        -- Return the total successfully processed back to Java
        o_processed_count := v_count;

        -- Note: We DO NOT issue a COMMIT here. 
        -- Spring Boot's JdbcTemplate is managing the transaction automatically.

    EXCEPTION
        WHEN OTHERS THEN
            -- If an error occurs (e.g. invalid contract number), let it crash and propagate up.
            -- Spring Boot catches this in your try/catch block and marks the group as FAILED in the HTML.
            RAISE;
    END sp_bulk_payment_hold;

END pg_fuze_bulk_upd;





