                v_eventid := NULL;

                v_contract_said :=
                    pg_contract.get_cur_contract (
                        TO_NUMBER (rec.contractnbr));
                intranet.pkg_contract.check_if_cur_contract (v_contract_said);

                --Get latest QC_Event
                IF rec.eventid IS NULL
                THEN
                    BEGIN
                        --                        NETSITES.PG_QC.GET_LATEST_EVENT (
                        --                            I_CONTRACT_SAID      => v_contract_said,
                        --                            I_QC_CATEGORY_TYPE   => rec.qccategory,
