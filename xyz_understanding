CREATE OR REPLACE PACKAGE BODY NETSITES."PG_FUZE_BULK_UPD" 
AS
    PROCEDURE bulk_update_wrapper (sourcetype                 VARCHAR2,
                                   actiontype                 VARCHAR2,
                                   updatedatajson             CLOB,
                                   contract_nbrlistjson       CLOB,
                                   userid                     VARCHAR2,
                                   o_ref_cur              OUT ref_cur)
    AS
    BEGIN
        IF sourcetype = 'NOTICE_RECIPIENT'
        THEN
            DBMS_OUTPUT.put_line ('sourceType: ' || sourcetype);

            IF actiontype = 'REPLACE'
            THEN
                DBMS_OUTPUT.put_line ('actiontype: ' || actiontype);
                bulk_replace_notice_rec (updatedatajson,
                                         contract_nbrlistjson,
                                         userid,
                                         o_ref_cur);
            ELSIF actiontype = 'ADD'
            THEN
                DBMS_OUTPUT.put_line ('actiontype: ' || actiontype);
                bulk_add_notice_rec (updatedatajson,
                                     contract_nbrlistjson,
                                     userid,
                                     o_ref_cur);
            ELSIF actiontype = 'GET'
            THEN
                bulk_get_notice_rec (contract_nbrlistjson, o_ref_cur);
            ELSIF actiontype = 'DEL'
            THEN
                bulk_del_notice_rec (updatedatajson,
                                     contract_nbrlistjson,
                                     userid,
                                     o_ref_cur);
            END IF;
        ELSIF sourcetype = 'OWNER'
        THEN
            DBMS_OUTPUT.put_line ('sourceType: ' || sourcetype);

            IF actiontype = 'ADD' OR actiontype = 'REPLACE'
            THEN
                DBMS_OUTPUT.put_line ('actiontype: ' || actiontype);
                bulk_add_owner (updatedatajson,
                                contract_nbrlistjson,
                                userid,
                                o_ref_cur);
            ELSIF actiontype = 'GET'
            THEN
                bulk_get_owner (contract_nbrlistjson, o_ref_cur);
            END IF;
        END IF;
    END bulk_update_wrapper;

    PROCEDURE bulk_update_fields_wrapper (
        sourcetype                 VARCHAR2,
        actiontype                 VARCHAR2,
        updatedatajson             CLOB,
        contract_nbrlistjson       CLOB,
        userid                     VARCHAR2,
        o_ref_cur              OUT ref_cur)
    AS
    BEGIN
        IF sourcetype = 'MAIN'
        THEN
            IF actiontype = 'TERMINATE'
            THEN
                bulk_update_termination (updatedatajson,
                                         contract_nbrlistjson,
                                         userid,
                                         o_ref_cur);
            ELSIF actiontype = 'COMMENT'
            THEN
                bulk_update_comment (updatedatajson,
                                     contract_nbrlistjson,
                                     userid,
                                     o_ref_cur);
            ELSIF actiontype = 'MASTER'
            THEN
                bulk_update_master (updatedatajson,
                                    contract_nbrlistjson,
                                    userid,
                                    o_ref_cur);
            ELSIF actiontype = 'FACILITY'
            THEN
                bulk_update_facility (updatedatajson,
                                      contract_nbrlistjson,
                                      userid,
                                      o_ref_cur);
            ELSIF actiontype = 'SITECONTROL'
            THEN
                bulk_update_site_control (updatedatajson,
                                          contract_nbrlistjson,
                                          userid,
                                          o_ref_cur);
            END IF;

            IF sourcetype = 'CUSTOMATTR'
            THEN
                bulk_update_custom_attr (updatedatajson,
                                         contract_nbrlistjson,
                                         userid);
            END IF;
        END IF;
    END bulk_update_fields_wrapper;

    PROCEDURE bulk_replace_notice_rec (jsondata                   CLOB,
                                       contract_nbrlistjson       CLOB,
                                       userid                     VARCHAR2,
                                       o_ref_cur              OUT ref_cur)
    AS
        i_counter             NUMBER;
        i_flag_set            NUMBER;
        i_contract_id         NUMBER;
        i_party_oldid         NUMBER;
        i_party_id            NUMBER;
        i_party_oldtp         VARCHAR2 (20);
        i_party_tp            VARCHAR2 (20);
        i_qc_category_type    NUMBER;
        i_eventid             NUMBER;
        o_trc_latest_event    trc_latest_event;
        v_eventid             intranet.qc_event.eventid%TYPE := NULL;
        v_auditid             intranet.qc_audit.auditid%TYPE := NULL;
        c_obj_name   CONSTANT VARCHAR2 (200) := app_log.who_am_i;

        i_array_t_failure     array_t;

        TYPE t_tab IS TABLE OF NUMBER;

        l_tab1                t_tab := t_tab ();

        CURSOR cur IS
            WITH
                tmp
                AS
                    (SELECT jt.*
                       FROM JSON_TABLE (
                                jsondata,
                                '$.jsonData.noticeRec[*]'
                                COLUMNS (
                                    id FOR ORDINALITY,
                                    partyoldid NUMBER PATH '$.partyOldId',
                                    partyid NUMBER PATH '$.partyId',
                                    partyoldtp
                                        VARCHAR2 (20)
                                        PATH '$.partyOldTp',
                                    partytp VARCHAR2 (20) PATH '$.partyTp',
                                    qccategory NUMBER PATH '$.qcCategory',
                                    eventid NUMBER PATH '$.eventId',
                                    NESTED PATH '$.contractNumberArr[*]'
                                        COLUMNS (
                                            contractNum_ID FOR ORDINALITY,
                                            contractid PATH '$.contractNum')))
                            jt)
            SELECT DISTINCT partyoldid,
                            partyid,
                            partyoldtp,
                            partytp,
                            qccategory,
                            eventid,
                            contractNum_ID,
                            contractid
              FROM tmp;
    BEGIN
        DBMS_APPLICATION_INFO.set_client_info (userid);
        DBMS_APPLICATION_INFO.set_module (
            'Bulk notice add - ' || TRUNC (SYSDATE),
            '');

        i_array_t_failure := NEW array_t ();


        i_counter := 0;
        i_flag_set := 0;

        FOR rec IN cur
        LOOP
            BEGIN
                --                DBMS_OUTPUT.put_line ('Contract ID: ' || rec.contractid);
                v_eventid := NULL;

                --Get latest QC_Event

                IF rec.eventid IS NULL
                THEN
                    BEGIN
                        --                        NETSITES.PG_QC.GET_LATEST_EVENT (
                        --                            I_CONTRACT_SAID      =>
                        --                                pg_contract.get_cur_contract (
                        --                                    TO_NUMBER (rec.contractid)),
                        --                            I_QC_CATEGORY_TYPE   => rec.qccategory,
                        --                            O_TRC_QC_EVENTS      => o_trc_latest_event);

                        NETSITES.PG_QC.GET_LATEST_EVENT_FUZE (
                            I_CONTRACT_SAID      =>
                                pg_contract.get_cur_contract (
                                    TO_NUMBER (rec.contractid)),
                            I_QC_CATEGORY_TYPE   => rec.qccategory,
                            I_USER_ID            => userid,
                            O_TRC_QC_EVENTS      => o_trc_latest_event);

                        --OPEN o_trc_latest_event;
                        LOOP
                            FETCH o_trc_latest_event
                                INTO v_eventid, v_auditid;

                            EXIT WHEN o_trc_latest_event%NOTFOUND;
                        END LOOP;

                        CLOSE o_trc_latest_event;
                    EXCEPTION
                        WHEN OTHERS
                        THEN
                            intranet.pkg_err.handle (SQLCODE,
                                                     SQLERRM,
                                                     TRUE,
                                                     TRUE,
                                                     c_obj_name,
                                                     userid);
                    END;
                ELSE
                    v_eventid := rec.eventid;
                END IF;

                DBMS_OUTPUT.put_line (
                       'Contract ID: AND event id  QC '
                    || rec.contractid
                    || '-----'
                    || rec.eventid
                    || '----'
                    || rec.qccategory
                    || '--v_eventid--'
                    || v_eventid);

                BEGIN
                    pg_notc.contact_insert_upd (
                        i_contract_id        =>
                            pg_contract.get_cur_contract (
                                TO_NUMBER (rec.contractid)),
                        i_party_oldid        => rec.partyoldid,
                        i_party_id           => rec.partyid,
                        i_party_oldtp        => rec.partyoldtp,
                        i_party_tp           => rec.partytp,
                        i_qc_category_type   => rec.qccategory,
                        i_eventid            => v_eventid);
                EXCEPTION
                    WHEN OTHERS
                    THEN
                        DBMS_OUTPUT.put_line (
                            'Exception Contract ID: ' || rec.contractid);
                        i_flag_set := i_flag_set + 1;
                        i_array_t_failure.EXTEND;
                        i_array_t_failure (i_flag_set) := rec.contractid;
                --                    open o_ref_cur for
                --                       select * from table( i_array_t_failure ) ;
                END;
            EXCEPTION
                WHEN OTHERS
                THEN
                    i_flag_set := i_flag_set + 1;
            --                    DBMS_OUTPUT.put_line (
            --                        'Exception2 Contract ID: ' || rec.contractid);
            --                    i_array_t_failure.EXTEND;
            --                    DBMS_OUTPUT.put_line ('Exception3  ID: ' || i_flag_set);
            --                    i_array_t_failure (i_flag_set) := rec.contractid;
            --                    DBMS_OUTPUT.put_line ('Exception4  ID: ' || i_flag_set);
            --                    open o_ref_cur for
            --                        select * from table( i_array_t_failure ) ;

            END;

            i_counter := i_counter + 1;
        END LOOP;

        COMMIT;

        -- Identify distinct and return to main arr_sampleid
        DBMS_OUTPUT.put_line (
            'Array Failure Count  : ' || i_array_t_failure.COUNT);

        IF i_array_t_failure.COUNT > 0
        THEN
            FOR i IN i_array_t_failure.FIRST .. i_array_t_failure.LAST
            LOOP
                l_tab1.EXTEND;
                l_tab1 (i) := i_array_t_failure (i);
            END LOOP;

            l_tab1 := l_tab1 MULTISET INTERSECT DISTINCT l_tab1;

            i_array_t_failure := NEW array_t ();

            FOR i IN l_tab1.FIRST .. l_tab1.LAST
            LOOP
                i_array_t_failure.EXTEND;
                i_array_t_failure (i) := l_tab1 (i);

                --                DBMS_OUTPUT.put_line (
                --                       'i_array_t_failure---('
                --                    || i
                --                    || '): '
                --                    || i_array_t_failure (i));

                OPEN o_ref_cur FOR SELECT * FROM TABLE (i_array_t_failure);
            END LOOP;
        END IF;
    END bulk_replace_notice_rec;

    PROCEDURE bulk_add_notice_rec (jsondata                   CLOB,
                                   contract_nbrlistjson       CLOB,
                                   userid                     VARCHAR2,
                                   o_ref_cur              OUT ref_cur)
    AS
        i_counter           NUMBER;
        i_flag_set          NUMBER;

        i_array_t_failure   array_t;

        TYPE t_tab IS TABLE OF NUMBER;

        l_tab1              t_tab := t_tab ();

        CURSOR cur IS
            WITH
                tmp
                AS
                    (SELECT jt.*, b.*
                       FROM JSON_TABLE (
                                jsondata,
                                '$.jsonData.noticeRec[*]'
                                COLUMNS (
                                    partyoldid NUMBER PATH '$.partyOldId',
                                    partyid NUMBER PATH '$.partyId',
                                    partyoldtp
                                        VARCHAR2 (20)
                                        PATH '$.partyOldTp',
                                    partytp VARCHAR2 (20) PATH '$.partyTp',
                                    qccategory NUMBER PATH '$.qcCategory',
                                    eventid NUMBER PATH '$.eventId')) jt,
                            JSON_TABLE (contract_nbrlistjson,
                                        '$[*]'
                                        COLUMNS (contractid PATH '$')) b)
            SELECT *
              FROM tmp;
    BEGIN
        DBMS_APPLICATION_INFO.set_client_info (userid);
        DBMS_APPLICATION_INFO.set_module (
            'Bulk notice add - ' || TRUNC (SYSDATE),
            '');

        i_array_t_failure := NEW array_t ();


        i_counter := 0;
        i_flag_set := 0;

        FOR rec IN cur
        LOOP
            DECLARE
                i_contract_id        NUMBER;
