                        1,                               --I_QC_SCREEN_ID=Main
                        1,                               --I_EVENT_LOG_STATUS,
                           'Contract '
                        || v_contract_nbr
                        || '-'
                        || v_amendment_nbr
                        || ' is updated.',
                        rec.qcCategory,
                        v_eventid,
                        userid,
                        v_session);
                END IF;
            EXCEPTION
                WHEN OTHERS
                THEN
                    i_flag_set := i_flag_set + 1;

                    DBMS_OUTPUT.put_line (
                        'Exception2 Contract ID: ' || rec.contractnbr);
                    i_array_t_failure.EXTEND;
                    DBMS_OUTPUT.put_line ('Exception3  ID: ' || i_flag_set);
                    i_array_t_failure (i_flag_set) := rec.contractnbr;
                    DBMS_OUTPUT.put_line ('Exception4  ID: ' || i_flag_set);

                    OPEN o_ref_cur FOR
                        SELECT * FROM TABLE (i_array_t_failure);
            END;

            i_counter := i_counter + 1;
        END LOOP;

        COMMIT;
    END bulk_update_termination;

